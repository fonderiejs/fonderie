# Local scripts. Every .mjs under the root scripts/ is repo tooling and is
# tracked; per-file re-includes made each NEW gate silently miss its commit
# (CI then failed with "Cannot find module" — three times). Local helpers
# (.sh and the like) stay ignored.
**/scripts/*
!scripts/*.mjs

# Editor / tool state — but ship .claude/skills, it's part of the product
.claude/*
!.claude/skills/
.idea/
.turbo/
.DS_Store
graphify-out/

