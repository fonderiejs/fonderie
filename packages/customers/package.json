{
	"name": "@fonderie/customers",
	"version": "6.5.0",
	"fonderie": {
		"stability": "stable"
	},
	"description": "Workspace-scoped customer records \u2014 individuals and businesses with multiple emails, phones, addresses, notes, and tags.",
	"keywords": [
		"fonderiejs",
		"customers",
		"saas",
		"typescript"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js",
			"require": "./dist/types.cjs"
		},
		"./migrations": {
			"types": "./dist/migrations/index.d.ts",
			"import": "./dist/migrations/index.js"
		},
		"./env.json": "./env.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup && tsup --config tsup.migrations.ts",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test src/__tests__/*.test.ts",
		"lint": "biome lint src",
		"format": "biome format --write src",
		"check": "biome check --write src"
	},
	"peerDependencies": {
		"@fonderie/core": "^0.29.0",
		"@fonderie/events": "^5.0.0",
		"@fonderie/store": "^0.7.0",
		"@fonderie/workspaces": "^6.0.0"
	},
	"peerDependenciesMeta": {
		"@fonderie/events": {
			"optional": true
		},
		"@fonderie/workspaces": {
			"optional": true
		}
	},
	"devDependencies": {
		"@fonderie/auth": "*",
		"@fonderie/core": "../core",
		"@fonderie/events": "../events",
		"@fonderie/permissions": "../permissions",
		"@fonderie/store": "../store",
		"@fonderie/workspaces": "../workspaces",
		"@types/node": "^26.6.3",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"brain",
		"LICENSE",
		"README.md",
		"env.json"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fonderiejs/fonderie.git",
		"directory": "packages/customers"
	},
	"homepage": "https://github.com/fonderiejs/fonderie/tree/main/packages/customers#readme",
	"bugs": {
		"url": "https://github.com/fonderiejs/fonderie/issues"
	},
	"dependencies": {
		"zod": "^4.6.5"
	}
}
