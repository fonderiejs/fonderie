{
	"name": "@fonderie/vue-admin-screens",
	"version": "0.6.0",
	"fonderie": {
		"stability": "experimental"
	},
	"description": "The admin shell for Vue: navigation by the operator's questions, seven pages over @fonderie/admin (attention, modules, doctor, configuration, routes, access, admin log), and the config/secrets and template screens composed as sub-pages under the one admin token. Mount it on one route; it owns nothing else.",
	"keywords": [
		"fonderiejs",
		"admin",
		"dashboard",
		"shell",
		"vue",
		"screens",
		"typescript"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint src",
		"format": "biome format --write src",
		"check": "biome check --write src"
	},
	"dependencies": {
		"@fonderie/client": "*",
		"@fonderie/vue-admin": "*",
		"@fonderie/vue-config-admin-screens": "*",
		"@fonderie/vue-courier-admin-screens": "*"
	},
	"peerDependencies": {
		"vue": ">=3.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.1",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vue": "^3.5.43"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fonderiejs/fonderie.git",
		"directory": "packages/vue-admin-screens"
	},
	"homepage": "https://github.com/fonderiejs/fonderie/tree/main/packages/vue-admin-screens#readme",
	"bugs": {
		"url": "https://github.com/fonderiejs/fonderie/issues"
	}
}
