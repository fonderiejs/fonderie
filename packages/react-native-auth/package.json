{
	"name": "@fonderie/react-native-auth",
	"version": "0.1.0",
	"description": "React Native hooks for Fonderie auth \u2014 thin bindings over @fonderie/client.",
	"keywords": [
		"fonderiejs",
		"react-native",
		"auth",
		"hooks",
		"typescript"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint src",
		"format": "biome format --write src",
		"check": "biome check --write src"
	},
	"dependencies": {
		"@fonderie/client": "*"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"@react-native-async-storage/async-storage": ">=1.18.0"
	},
	"devDependencies": {
		"@react-native-async-storage/async-storage": "3.1.1",
		"react-native": "0.87.0",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"react": "^19.2.8",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fonderiejs/fonderie.git",
		"directory": "packages/react-native-auth"
	},
	"homepage": "https://github.com/fonderiejs/fonderie/tree/main/packages/react-native-auth#readme",
	"bugs": {
		"url": "https://github.com/fonderiejs/fonderie/issues"
	}
}
