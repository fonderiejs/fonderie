{
	"name": "@fonderie/vue-workspaces-screens",
	"version": "0.5.3",
	"description": "Pre-built Vue workspaces screens for Fonderie — team members, invitations.",
	"keywords": [
		"fonderiejs",
		"vue",
		"workspaces",
		"teams",
		"screens",
		"ui",
		"typescript"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint src",
		"format": "biome format --write src",
		"check": "biome check --write src"
	},
	"dependencies": {
		"@fonderie/client": "^3.18.0",
		"@fonderie/vue": "^0.11.0",
		"@fonderie/vue-workspaces": "^0.12.0"
	},
	"peerDependencies": {
		"vue": ">=3.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vue": "^3.5.43"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fonderiejs/fonderie.git",
		"directory": "packages/vue-workspaces-screens"
	},
	"homepage": "https://github.com/fonderiejs/fonderie/tree/main/packages/vue-workspaces-screens#readme",
	"bugs": {
		"url": "https://github.com/fonderiejs/fonderie/issues"
	}
}
