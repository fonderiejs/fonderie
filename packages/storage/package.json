{
	"name": "@fonderie/storage",
	"version": "0.1.4",
	"description": "Content-agnostic, provider-abstracted object storage — store any bytes on Postgres, disk, or S3-compatible object storage (S3/MinIO/R2) behind one interface. The low-dependency foundation for media, archives, and more.",
	"keywords": [
		"fonderiejs",
		"storage",
		"object-storage",
		"s3",
		"minio",
		"blob",
		"saas",
		"typescript"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./s3": {
			"types": "./dist/s3.d.ts",
			"import": "./dist/s3.js",
			"require": "./dist/s3.cjs"
		},
		"./migrations": {
			"types": "./dist/migrations/index.d.ts",
			"import": "./dist/migrations/index.js"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup && tsup --config tsup.migrations.ts",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test src/__tests__/*.test.ts",
		"lint": "biome lint src",
		"format": "biome format --write src",
		"check": "biome check --write src"
	},
	"peerDependencies": {
		"@fonderie/core": "^0.10.0",
		"@fonderie/store": "^0.3.0",
		"@aws-sdk/client-s3": "^3.0.0",
		"@aws-sdk/s3-request-presigner": "^3.0.0"
	},
	"peerDependenciesMeta": {
		"@aws-sdk/client-s3": {
			"optional": true
		},
		"@aws-sdk/s3-request-presigner": {
			"optional": true
		}
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.0.0",
		"@aws-sdk/s3-request-presigner": "^3.0.0",
		"@fonderie/core": "../core",
		"@fonderie/store": "../store",
		"@types/node": "^26.4.1",
		"tsup": "^8.5.1",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"brain",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fonderiejs/fonderie.git",
		"directory": "packages/storage"
	},
	"homepage": "https://github.com/fonderiejs/fonderie/tree/main/packages/storage#readme",
	"bugs": {
		"url": "https://github.com/fonderiejs/fonderie/issues"
	}
}
