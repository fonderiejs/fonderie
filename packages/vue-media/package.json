{
	"name": "@fonderie/vue-media",
	"version": "0.2.0",
	"description": "Vue 3 composables for Fonderie media — image/avatar upload over @fonderie/client.",
	"keywords": [
		"fonderiejs",
		"vue",
		"media",
		"avatar",
		"upload",
		"image",
		"composables",
		"typescript"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test src/__tests__/*.test.ts",
		"lint": "biome lint src",
		"format": "biome format --write src",
		"check": "biome check --write src"
	},
	"dependencies": {
		"@fonderie/client": "^2.5.0",
		"@fonderie/vue": "^0.5.1"
	},
	"peerDependencies": {
		"vue": ">=3.3.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vue": "^3.5.43"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fonderiejs/fonderie.git",
		"directory": "packages/vue-media"
	},
	"homepage": "https://github.com/fonderiejs/fonderie/tree/main/packages/vue-media#readme",
	"bugs": {
		"url": "https://github.com/fonderiejs/fonderie/issues"
	}
}
