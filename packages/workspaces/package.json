{
  "name": "@fonderie/workspaces",
  "version": "5.0.0",
  "description": "Multi-tenant team layer — create workspaces, manage members, define custom roles, handle token-based invitations, and scope any route to a specific workspace.",
  "keywords": [
    "fonderie-js",
    "workspaces",
    "multi-tenant",
    "teams",
    "organizations",
    "invitations",
    "rbac",
    "saas",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./middleware": {
      "types": "./dist/middlewares/index.d.ts",
      "import": "./dist/middlewares/index.js",
      "require": "./dist/middlewares/index.cjs"
    },
    "./migrations": {
      "types": "./dist/migrations/index.d.ts",
      "import": "./dist/migrations/index.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && tsup --config tsup.migrations.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/__tests__/*.test.ts",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "check": "biome check --write src"
  },
  "peerDependencies": {
    "@fonderie/core": "^0.5.0",
    "@fonderie/events": "^5.0.0",
    "@fonderie/store": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@fonderie/events": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fonderie/billing": "../billing",
    "@fonderie/core": "../core",
    "@fonderie/events": "../events",
    "@fonderie/store": "../store",
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "brain",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fonderiejs/fonderie.git",
    "directory": "packages/workspaces"
  },
  "homepage": "https://github.com/fonderiejs/fonderie/tree/main/packages/workspaces#readme",
  "bugs": {
    "url": "https://github.com/fonderiejs/fonderie/issues"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
