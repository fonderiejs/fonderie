{
	"name": "@fonderie/client",
	"version": "0.10.0",
	"description": "Isomorphic TypeScript client for Fonderie-powered APIs \u2014 fully typed request and response shapes, zero runtime dependencies.",
	"keywords": [
		"fonderiejs",
		"client",
		"http-client",
		"sdk",
		"saas",
		"typescript"
	],
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test src/__tests__/*.test.ts"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"tsx": "^4.21.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"brain",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fonderiejs/fonderie.git",
		"directory": "packages/client"
	},
	"homepage": "https://github.com/fonderiejs/fonderie/tree/main/packages/client#readme",
	"bugs": {
		"url": "https://github.com/fonderiejs/fonderie/issues"
	}
}
