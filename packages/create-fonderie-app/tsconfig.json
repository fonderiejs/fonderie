{
	// Deliberately does NOT extend tsconfig.base.json: the base targets
	// tsup-bundled libraries (module esnext + bundler resolution); this package
	// is the scaffolding tool that runs directly on Node, so it needs NodeNext.
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "es2022",
		"lib": ["ES2022"],
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"resolveJsonModule": true
	},
	"include": ["src"]
}
