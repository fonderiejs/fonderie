{
  "name": "@fonderie/sdk",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "create-app": "npm run build -w packages/create-fonderie-app && node packages/create-fonderie-app/dist/bin.js",
    "dev": "npm run dev --workspaces --if-present",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "biome lint .",
    "lint:ci": "biome lint packages --diagnostic-level=error",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "changeset": "changeset",
    "version": "changeset version && npm run docs:brain",
    "release": "npm run build && changeset publish",
    "docs:signatures": "npm run docs:signatures:index && npm run docs:signatures:outcomes",
    "docs:brain": "npm run docs:brain:graph && npm run docs:brain:cli-data",
    "brain:serve": "node scripts/brain-serve.mjs",
    "brain:test": "npm run brain:serve:test && npm run brain:completeness",
    "brain:project": "node scripts/generate-project-brain.mjs",
    "brain:project-test": "node scripts/project-brain.test.mjs",
    "brain:r3-test": "node scripts/brain-r3.test.mjs",
    "audit:validation": "node scripts/audit-validation.mjs",
    "check:evidence": "node scripts/check-evidence.mjs",
    "check:hook-coverage": "node scripts/check-hook-coverage.mjs",
    "check:routes": "node scripts/check-client-routes.mjs",
    "check:template-coverage": "node scripts/check-template-coverage.mjs",
    "audit:ship": "npm audit --audit-level=high --omit=dev --omit=peer",
    "check:hook-parity": "node scripts/check-hook-parity.mjs",
    "brain:completeness": "node scripts/brain-completeness.test.mjs",
    "docs:signatures:index": "node scripts/generate-signatures.mjs",
    "docs:signatures:outcomes": "node scripts/generate-outcomes.mjs",
    "docs:brain:graph": "node scripts/generate-brain.mjs",
    "docs:brain:cli-data": "node scripts/generate-cli-data.mjs",
    "brain:serve:test": "node scripts/brain-serve.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "turbo": "^2.11.2"
  },
  "license": "MIT",
  "packageManager": "npm@11.16.0"
}
