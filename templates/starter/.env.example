# ── Required ─────────────────────────────────────────────────────────────────
# A Postgres your app can reach. For a serverless deploy this must be a HOSTED
# database (Neon, Supabase, RDS, …) — a localhost or SSH-tunnelled one is not
# reachable from the platform. On Supabase use the TRANSACTION POOLER string
# here, and the DIRECT one for `npm run migrate`.
DATABASE_URL=postgres://localhost:5432/fonderie_starter

# 32+ random chars: `openssl rand -hex 32`. Auth REFUSES TO BOOT under
# NODE_ENV=production if this looks like a placeholder or dev default.
JWT_SECRET=change-me-in-production-min-32-chars

# ── Optional ─────────────────────────────────────────────────────────────────
# The browser frontend's origin. Set it to enable CORS — without it, browser
# calls from another origin are blocked by the preflight. It is also the return
# origin for any hosted checkout you add later.
FRONTEND_URL=http://localhost:5173

# Port for the local/Docker server (ignored on serverless).
PORT=3000
