{
	"name": "example-express",
	"version": "1.0.0",
	"description": "Minimal Fonderie todo app using Express — deployable to Vercel or any Node host",
	"type": "module",
	"scripts": {
		"dev": "tsx --env-file=.env index.ts",
		"start": "tsx index.ts",
		"migrate": "tsx --env-file=.env migrate.ts",
		"setup": "cp -n .env.example .env || true",
		"test": "tsx --test *.test.ts"
	},
	"dependencies": {
		"express": "^4.21.2",
		"@fonderie/adapter-express": "^5.0.0",
		"@fonderie/auth": "^5.0.0",
		"@fonderie/core": "^0.5.0",
		"@fonderie/events": "^5.0.0",
		"@fonderie/store": "^0.2.2"
	},
	"devDependencies": {
		"@types/express": "^5.0.2",
		"@types/node": "^25.6.2",
		"tsx": "^4.21.0"
	},
	"private": true
}
