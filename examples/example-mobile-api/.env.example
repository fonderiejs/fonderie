DATABASE_URL=postgres://localhost/fonderie_mobile
JWT_SECRET=dev-secret-min-32-chars-long-here
NODE_ENV=development
PORT=4004

# Only needed to open a real Stripe checkout. Listing plans and reading the
# current subscription both work without it.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at /billing/webhook
# (`stripe listen` prints one locally). Without it subscription changes never sync.
STRIPE_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=saasstarter://settings/billing
BILLING_CANCEL_URL=saasstarter://settings/billing
