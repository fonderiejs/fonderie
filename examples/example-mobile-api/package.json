		"test": "tsx --test *.test.ts",
		"migrate": "tsx --env-file=.env migrate.ts"
	},
	"dependencies": {
		"@fonderie/adapter-hono": "^6.1.3",
		"@fonderie/audit": "^5.1.8",
		"@fonderie/auth": "^7.3.5",
		"@fonderie/billing": "^9.1.5",
		"@fonderie/core": ">=0.14.0",
		"@fonderie/courier": "^7.0.5",
		"@fonderie/events": "^5.2.0",
		"@fonderie/store": "^0.3.0",
		"@fonderie/workspaces": "^6.0.7",
		"@hono/node-server": "^1.13.7",
		"hono": "^4.7.11",
		"stripe": "^22.6.0"
	},
	"devDependencies": {
		"@types/node": "^25.6.2",
		"tsx": "^4.21.0"
	}
