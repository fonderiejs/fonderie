{
	"name": "example-mobile-api",
	"version": "1.0.0",
	"description": "Fonderie backend that speaks the SaaS Starter's REST contract — auth, teams, billing, projects",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx --env-file=.env index.ts",
		"start": "tsx index.ts",
		"setup": "cp -n .env.example .env || true",
		"test": "tsx --test *.test.ts",
		"migrate": "tsx --env-file=.env migrate.ts"
	},
	"dependencies": {
		"@fonderie/adapter-hono": "^6.2.9",
		"@fonderie/audit": "^5.2.7",
		"@fonderie/auth": "^7.13.0",
		"@fonderie/billing": "^10.2.0",
		"@fonderie/core": ">=0.22.0",
		"@fonderie/courier": "^7.12.0",
		"@fonderie/events": "^5.9.4",
		"@fonderie/store": ">=0.7.1",
		"@fonderie/workspaces": "^6.1.0",
		"@hono/node-server": "^1.13.7",
		"hono": "^4.7.11",
		"stripe": "^22.6.0"
	},
	"devDependencies": {
		"@types/node": "^25.6.2",
		"tsx": "^4.21.0"
	}
}
