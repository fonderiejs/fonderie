{
  "name": "example-hono",
  "version": "1.0.0",
  "description": "Minimal Fonderie todo app using Hono \u2014 deployable to Vercel or any Node host",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env index.ts",
    "start": "tsx index.ts",
    "setup": "cp -n .env.example .env || true",
    "test": "tsx --test *.test.ts",
    "migrate": "tsx --env-file=.env migrate.ts"
  },
  "dependencies": {
    "hono": "^4.7.11",
    "@hono/node-server": "^1.13.7",
    "@fonderie/adapter-hono": "^6.0.0",
    "@fonderie/auth": "^7.0.1",
    "@fonderie/core": ">=0.10.0",
    "@fonderie/courier": "^7.0.0",
    "@fonderie/events": "^5.0.6",
    "@fonderie/store": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0"
  }
}
