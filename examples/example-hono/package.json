{
	"name": "example-hono",
	"version": "1.0.0",
	"description": "Minimal Fonderie todo app using Hono — deployable to Vercel or any Node host",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx --env-file=.env index.ts",
		"start": "tsx index.ts",
		"setup": "cp -n .env.example .env || true",
		"test": "tsx --test *.test.ts",
		"migrate": "tsx --env-file=.env migrate.ts"
	},
	"dependencies": {
		"hono": "^4.7.11",
		"@hono/node-server": "^1.13.7",
		"@fonderie/adapter-hono": "^6.3.7",
		"@fonderie/auth": "^7.23.0",
		"@fonderie/core": ">=0.31.0",
		"@fonderie/courier": "^7.15.0",
		"@fonderie/events": "^5.12.3",
		"@fonderie/store": ">=0.7.2"
	},
	"devDependencies": {
		"@types/node": "^25.6.2",
		"tsx": "^4.21.0"
	}
}
