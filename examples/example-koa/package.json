{
	"name": "example-koa",
	"version": "1.0.0",
	"description": "Minimal Fonderie todo app using Koa — deployable to Vercel or any Node host",
	"type": "module",
	"scripts": {
		"dev": "tsx --env-file=.env index.ts",
		"start": "tsx index.ts",
		"migrate": "tsx --env-file=.env migrate.ts",
		"setup": "cp -n .env.example .env || true",
		"test": "tsx --test *.test.ts"
	},
	"dependencies": {
		"koa": "^2.16.1",
		"@koa/router": "^13.1.0",
		"koa-bodyparser": "^4.4.1",
		"@fonderie/adapter-koa": "^5.2.0",
		"@fonderie/auth": "^7.0.1",
		"@fonderie/core": ">=0.10.0",
		"@fonderie/events": "^5.2.1",
		"@fonderie/store": "^0.3.0",
		"@fonderie/courier": "^7.0.0"
	},
	"devDependencies": {
		"@types/koa": "^2.15.0",
		"@types/koa-bodyparser": "^4.3.12",
		"@types/koa__router": "^12.0.4",
		"@types/node": "^25.6.2",
		"tsx": "^4.21.0"
	},
	"private": true
}
